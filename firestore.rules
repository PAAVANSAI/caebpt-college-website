rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'admin@caebpt.ac.in'
      );
    }

    // Public read-only institutional content & site settings; writes strictly admin-only
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /content/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admissions enquiries: public can submit validated new enquiries, only admin can read/update/delete
    match /enquiries/{enquiryId} {
      allow create: if request.resource.data.keys().hasAll(['id', 'fullName', 'phone', 'email', 'course', 'date', 'status'])
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 3
        && request.resource.data.fullName.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 150
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 20
        && request.resource.data.status == 'New';
      allow read, update, delete: if isAdmin();
    }

    // Traffic pageview counter: public read & bounded increment only
    match /traffic/stats {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['todayViews', 'lastActive']);
      allow delete: if isAdmin();
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
